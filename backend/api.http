@baseUrl = http://localhost:3000

### Health check
GET {{baseUrl}}/health

### ==================== AUTH ====================

### Registro - adoptante
POST {{baseUrl}}/api/auth/registro
Content-Type: application/json

{
  "nombre_completo": "Jose Test",
  "email": "jose@test.com",
  "password": "123456",
  "rol": "ADOPTANTE"
}

### Registro - refugio
POST {{baseUrl}}/api/auth/registro
Content-Type: application/json

{
  "nombre_completo": "Refugio Los Amigos",
  "email": "refugio@test.com",
  "password": "123456",
  "rol": "REFUGIO"
}

### Login - adoptante
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "jose@test.com",
  "password": "123456"
}

### Login - refugio
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "refugio@test.com",
  "password": "123456"
}

